PORT=4000
DATABASE_URL=postgres://postgres:password@localhost:5432/officepool
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# LinkedIn OAuth (for verified badge)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://yourapp.com/api/auth/linkedin/callback

# Twilio (OTP for phone verification)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Email (for work-email OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Pricing
DEFAULT_PRICE_PER_KM=5.00
PLATFORM_FEE_PERCENT=10
