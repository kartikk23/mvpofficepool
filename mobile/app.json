{
  "expo": {
    "name": "OfficePool",
    "slug": "officepool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "officepool",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B5FFF"
    },
    "android": {
      "package": "com.officepool.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBvQo4nuhx0RHd27Emqi3_DqNepbBI6FzA"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5FFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.officepool.app",
      "buildNumber": "1.0.0",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OfficePool needs your location to match you with nearby colleagues commuting the same route.",
        "NSCameraUsageDescription": "OfficePool needs camera access to set your profile photo and verify documents."
      }
    },
    "plugins": [
      "expo-location"
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.16:4000",
      "linkedinClientId": "YOUR_LINKEDIN_CLIENT_ID",
      "googleMapsApiKey": "AIzaSyBvQo4nuhx0RHd27Emqi3_DqNepbBI6FzA",
      "eas": {
        "projectId": "2fa554a3-0601-4fe2-9191-b4d177e97bc4"
      }
    }
  }
}
